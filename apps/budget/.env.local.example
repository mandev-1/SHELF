# Copy to .env.local and fill in. The app talks ONLY to the Go Budget API (which
# fronts Supabase) — there are no Supabase keys in the browser anymore.
#
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix), so they never reach the client
# bundle. A Next.js route handler (app/api/[...path]) injects the token when it
# proxies the browser's same-origin /api/* calls to the Go API.

# Base URL of the deployed Go API (no trailing slash).
BUDGET_API_URL=https://shelf-yh5b.onrender.com

# Bearer token matching API_TOKEN on the Go service. Leave empty only if the API
# is running open (no token).
BUDGET_API_TOKEN=

# Local dev against the Dockerized API instead:
#   BUDGET_API_URL=http://localhost:8080
#   BUDGET_API_TOKEN=<the same API_TOKEN your local API uses>
