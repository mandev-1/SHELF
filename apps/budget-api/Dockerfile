# syntax=docker/dockerfile:1

# ---- Stage 1: build ----------------------------------------------------------
FROM golang:1.22-alpine AS build

WORKDIR /src

# Copy module files first so dependency download is cached independently of
# source changes. go.sum may not exist yet (it's generated by `go mod tidy`);
# the wildcard tolerates its absence.
COPY go.mod go.sum* ./
RUN go mod download

# Copy the rest of the source and build a fully static binary.
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./

# ---- Stage 2: runtime --------------------------------------------------------
FROM gcr.io/distroless/static-debian12

COPY --from=build /out/server /server

# Documentation only; Render injects PORT at runtime and the server reads it.
EXPOSE 8080

ENTRYPOINT ["/server"]
